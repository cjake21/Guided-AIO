def check_drift(observed):
    alerts = []
    for flow in observed:
        if flow not in APPROVED:
            alerts.append({
                "time": datetime.utcnow().isoformat(),
                "src": flow[0],
                "dst": flow[1],
                "service": flow[2],
                "msg": "Unexpected conduit"
            })
    return alerts

